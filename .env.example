# --- Google Maps Platform (server-side key; never exposed to the browser) ---
# Enable: Places API (New) and Maps Static API. Restrict the key to those two APIs.
# Without this key the site runs in demo mode with a sample property.
GOOGLE_MAPS_API_KEY=

# --- Claude (measures driveway / sidewalk / walkway from the satellite image) ---
# Without this key customers outline their surfaces by hand.
ANTHROPIC_API_KEY=
# Optional override. Default: claude-opus-5-5
# ANTHROPIC_MODEL=

# --- Where booking requests are emailed (any SMTP mailbox works) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Address that receives new bookings, and the From address customers see.
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=

# --- Shown on the site (leave blank to hide) ---
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_SITE_URL=
